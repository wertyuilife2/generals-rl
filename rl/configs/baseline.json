{
  "task": {
    "num_envs": 64,
    "max_episode_steps": 512,
    "history_length": 4
  },
  "runner": {
    "num_steps_per_env": 32,
    "algorithm": {
      "teacher_env_ratio": 0.75,
      "num_learning_epochs": 4,
      "num_mini_batches": 4,
      "gamma": 0.99
    }
  },
  "self_play": {
    "pool_size": 8,
    "snapshot_interval": 50
  },
  "evaluation": {
    "enabled": true,
    "every_n_snapshots": 10
  }
}
